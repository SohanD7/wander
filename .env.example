# Where the Yjs websocket relay lives. Defaults to the same host as the page, port 1234.
# Set this when you deploy the relay somewhere else (e.g. wss://wander-sync.example.com).
VITE_SYNC_URL=

# Server only. Disabled unless explicitly enabled; use sample values only for local simulation.
TWILIO_CONVERSATIONS_ENABLED=0
TWILIO_ACCOUNT_SID=AC11111111111111111111111111111111
TWILIO_AUTH_TOKEN=wander-sample-auth-token-not-a-real-secret
# Exact externally visible callback URL (scheme/path/query must match Twilio's configuration).
TWILIO_CONVERSATIONS_WEBHOOK_URL=http://127.0.0.1:1241/webhooks/twilio/conversations
TWILIO_CONVERSATION_TRIPS={"CH22222222222222222222222222222222":"pilot-lisbon-demo"}
TWILIO_WANDER_AUTHOR=wander
# Optional own participant SID provides an additional echo filter.
TWILIO_WANDER_PARTICIPANT_SID=MB99999999999999999999999999999999
WANDER_BOARD_BASE_URL=http://127.0.0.1:1241
# dry-run returns the board link in the webhook response; live dispatches through Conversations REST.
TWILIO_BOARD_REPLIES=dry-run

# Inbound Programmable Messaging SMS (independent of Conversations; no outbound replies).
TWILIO_SMS_ENABLED=0
TWILIO_SMS_WEBHOOK_URL=https://YOUR-HOST.example/webhooks/twilio/sms
TWILIO_SMS_TRIP_ID=pilot-lisbon-demo
TWILIO_SMS_TO=+12025550100
# Comma-separated tester phones, exact E.164 format. Empty allowlists fail startup.
TWILIO_SMS_TESTERS=+12025550101,+12025550102
# Uses the server-only TWILIO_AUTH_TOKEN above.

# ZeroSettle group pilot; all values are server-only. Private key file is auto-loaded.
ZEROSETTLE_ENABLED=0
# ZEROSETTLE_API_KEY is read from ignored .env.zeroSettle (also supports .env.zeroSettke).
ZEROSETTLE_WEBHOOK_SECRET=
ZEROSETTLE_WEBHOOK_URL=https://YOUR-HOST.example/webhooks/zerosettle
ZEROSETTLE_CHAT_ID=iMessage;+;chatYOUR_GROUP_ID
ZEROSETTLE_TESTER_HANDLES=+12025550101,bob@example.com
ZEROSETTLE_TRIP_ID=pilot-lisbon-demo
# Private JSON object: E.164 phone/email -> display name. Stable sender IDs do not change.
ZEROSETTLE_TESTER_NAMES={"+12025550101":"Alice","bob@example.com":"Bob"}
# Link cards save whether or not acknowledgments are enabled. No historical backfill sends.
# Enable only for the explicitly configured pilot group; requires server ZEROSETTLE_API_KEY.
ZEROSETTLE_ACKNOWLEDGMENTS=0

# Explicit native poll commands and signed poll.voted mirroring (independent of link acknowledgments).
ZEROSETTLE_POLLS=0
# Optional public HTTPS origin for fallback links; defaults to ZEROSETTLE_WEBHOOK_URL's origin.
# Never use localhost/LAN here: testers must be able to open the board on their phones.
ZEROSETTLE_BOARD_BASE_URL=

# Explicit Wanda checklist actions and one reply per command; independent of link acknowledgments.
ZEROSETTLE_LISTS=0

# Personal total-trip budget preferences and saved map places; separate explicit feature flags.
ZEROSETTLE_BUDGETS=0
ZEROSETTLE_PLACES=0
# Photon geocoding is separately opt-in, server-only, and cached/throttled. No API key needed.
ZEROSETTLE_GEOCODER_ENABLED=0
ZEROSETTLE_GEOCODER_URL=https://photon.komoot.io/api
ZEROSETTLE_GEOCODER_INTERVAL_MS=1100
ZEROSETTLE_GEOCODER_DAILY_LIMIT=50
ZEROSETTLE_GEOCODER_USER_AGENT="WanderPilot/1.0 (small trip pilot)"

# Hosted group trips. Local pilot commands continue to use file persistence.
WANDER_GROUP_TRIPS=0
# WANDER_PUBLIC_ORIGIN=https://your-existing-service.onrender.com
# DATABASE_URL=<direct TLS Postgres connection string, not a transaction pool>
# DATABASE_URL_UNPOOLED=<Neon direct connection; preferred when both Neon variables exist>
# WANDER_CLAIM_KEY=<persistent random secret, at least 32 characters>
# ZEROSETTLE_ACCOUNT_SCOPE=<stable private account label>
# ZEROSETTLE_ALLOWED_GROUPS=<comma-separated provider group chat IDs, or *>
